// ExtendPartner Product Marketing OS 3.0 — data model (P0)
// Rule: every tenant-owned model carries tenantId and is only accessed via the
// tenant-scoped data-access layer (src/server/db/tenant-scope.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum Role {
  viewer
  editor
  reviewer
  admin
}

enum DataClassification {
  public
  internal
  confidential
  restricted
}

enum SourceKind {
  public_web
  product_doc
  regulatory_text
  interview
  synthetic_demo
}

enum SourceStatus {
  active
  changed
  invalid
}

enum ClaimState {
  draft
  pending_review
  approved
  rejected
  stale
}

enum ClaimCategory {
  product_capability
  compliance
  security
  comparative
  commercial
  regulatory
}

enum AssetType {
  messaging_framework
  competitive_battlecard
  regulatory_gtm_brief
  product_intelligence_brief
  /// M8–M10: campaign package (campaign_gtm run)
  campaign_plan
  content_matrix
  sales_play
  /// M11: performance review (campaign_performance run)
  performance_review
  /// M12: use case map (use_case_definition run), GTM strategy brief (campaign_strategy run),
  /// release communication plan (release_communication run)
  use_case_map
  gtm_strategy_brief
  release_communication_plan
  /// M13a: product and conversion assets (campaign_asset run, enablement_asset.v1)
  product_page
  solution_brief
  whitepaper_outline
  thought_leadership
  regulatory_explainer
  case_study
  ad_copy
  webinar_outline
  video_script
  industry_narrative
  /// M13b: sales toolkit and training (campaign_asset run, enablement_asset.v1)
  pitch_deck_outline
  demo_story
  one_pager
  discovery_guide
  persona_playbook
  roi_argument
  sales_training
  /// M14: win/loss synthesis (win_loss_synthesis run)
  win_loss_synthesis
  /// M15: launch plan (launch_planning run)
  launch_plan
  /// M16: regulatory change brief (regulatory_impact run)
  regulatory_change_brief
}

enum KpiUnit {
  count
  percent
  currency_eur
  ratio
}

enum KpiDirection {
  higher_is_better
  lower_is_better
}

/// How the measurements of a KPI combine into its actual value.
enum KpiAggregation {
  sum
  latest
  average
}

/// What a campaign is meant to move. Drives the campaign plan and the sales play type.
enum CampaignType {
  demand_generation
  conversion
  retention
  loyalty
  sales_enablement
}

/// M12: what kind of release or update is planned. Drives the release tier the agent proposes.
enum ReleaseType {
  major_release
  feature_update
  maintenance_update
  security_update
  deprecation
}

/// M14: outcome of the deal a win/loss interview is about.
enum DealOutcome {
  won
  lost
  churned
  no_decision
}

/// M14: consent of the interviewee to store and use the interview notes.
enum ConsentStatus {
  requested
  granted
  declined
  withdrawn
}

/// M15: launch tier — tier_1 = broad market launch, tier_3 = quiet availability.
enum LaunchTier {
  tier_1
  tier_2
  tier_3
}

/// M15: the staged launch — early access → GA → existing customers → market.
enum LaunchPhase {
  early_access
  general_availability
  customer_launch
  market_launch
}

/// M15: a human go / no-go decision for one launch phase.
enum GoDecision {
  go
  no_go
}

/// M16: what kind of regulatory change the radar recorded.
enum RegulatoryChangeKind {
  deadline_shift
  scope_change
  new_guidance
  repeal
  other
}

enum AssetState {
  draft
  pending_review
  changes_requested
  approved
  archived
}

enum WorkflowStatus {
  created
  queued
  running
  validation
  pending_review
  completed
  failed
}

enum ApprovalDecision {
  approved
  rejected
  changes_requested
}

enum GenerationMode {
  live
  simulated
  /// A human edit of an earlier version (see AssetVersion.basedOnVersionId).
  human_edit
}

// ───────────────────────── Identity & tenancy ─────────────────────────

model Tenant {
  id                     String             @id @default(cuid())
  slug                   String             @unique
  name                   String
  isDemo                 Boolean            @default(false)
  /// Highest classification that may be sent to an external model provider.
  maxExternalModelClass  DataClassification @default(internal)
  externalModelsApproved Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  memberships            Membership[]
  products               Product[]
  sources                Source[]
  claims                 Claim[]
  personas               Persona[]
  buyerProblems          BuyerProblem[]
  competitors            Competitor[]
  competitorEvidence     CompetitorEvidence[]
  regulatoryTriggers     RegulatoryTrigger[]
  assets                 Asset[]
  assetVersions          AssetVersion[]
  workflowRuns           WorkflowRun[]
  approvals              Approval[]
  auditEvents            AuditEvent[]
  valuePropositions      ValueProposition[]
  productFeatures        ProductFeature[]
  claimEvidence          ClaimEvidence[]
  valuePropositionClaims ValuePropositionClaim[]
  campaigns              Campaign[]
  releases               Release[]
  kpis                   Kpi[]
  kpiMeasurements        KpiMeasurement[]
  kpiImports             KpiImport[]
  winLossInterviews      WinLossInterview[]
  launches               Launch[]
  launchDecisions        LaunchDecision[]
  regulatoryWatches      RegulatoryWatch[]
  regulatoryChanges      RegulatoryChange[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships    Membership[]
  approvals                 Approval[]
  reviewedClaims            Claim[]            @relation("ClaimReviewer")
  launchDecisions           LaunchDecision[]
  recordedRegulatoryChanges RegulatoryChange[] @relation("ChangeRecordedBy")
  resolvedRegulatoryChanges RegulatoryChange[] @relation("ChangeResolvedBy")
}

model Membership {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  role      Role
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

// ───────────────────────── Product knowledge ─────────────────────────

model Product {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  area        String
  description String
  isSynthetic Boolean  @default(false)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  features  ProductFeature[]
  claims    Claim[]
  campaigns Campaign[]
  releases  Release[]
  winLossInterviews WinLossInterview[]
  launches          Launch[]

  @@unique([id, tenantId])
  @@index([tenantId])
}

model ProductFeature {
  id          String   @id @default(cuid())
  tenantId    String
  productId   String
  name        String
  description String
  isSynthetic Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product           Product            @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Cascade)
  claims            Claim[]
  valuePropositions ValueProposition[]

  @@unique([id, tenantId])
  @@index([tenantId, productId])
}

model Source {
  id             String             @id @default(cuid())
  tenantId       String
  kind           SourceKind
  title          String
  /// Null for synthetic or internal sources. Never fabricated.
  url            String?
  publisher      String?
  classification DataClassification @default(internal)
  status         SourceStatus       @default(active)
  /// Stored text the excerpts are checked against (quality gate 4).
  content        String
  contentHash    String
  retrievedAt    DateTime?
  isSynthetic    Boolean            @default(false)
  version        Int                @default(1)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  claimEvidence      ClaimEvidence[]
  competitorEvidence CompetitorEvidence[]
  winLossInterviews  WinLossInterview[]
  regulatoryWatches  RegulatoryWatch[]

  @@unique([id, tenantId])
  @@index([tenantId, status])
}

model Claim {
  id             String        @id @default(cuid())
  tenantId       String
  productId      String
  featureId      String?
  text           String
  category       ClaimCategory
  state          ClaimState    @default(draft)
  reviewerId     String?
  approvedAt     DateTime?
  lastVerifiedAt DateTime?
  reviewDueAt    DateTime?
  staleReason    String?
  isSynthetic    Boolean       @default(false)
  version        Int           @default(1)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product           Product                 @relation(fields: [productId, tenantId], references: [id, tenantId])
  feature           ProductFeature?         @relation(fields: [featureId, tenantId], references: [id, tenantId])
  reviewer          User?                   @relation("ClaimReviewer", fields: [reviewerId], references: [id])
  evidence          ClaimEvidence[]
  valuePropositions ValuePropositionClaim[]

  @@unique([id, tenantId])
  @@index([tenantId, state])
}

/// Structured evidence: a claim is linked to a source with an exact excerpt
/// and optional locator (page, section, anchor). Not free-text citations.
model ClaimEvidence {
  id        String   @id @default(cuid())
  tenantId  String
  claimId   String
  sourceId  String
  excerpt   String
  locator   String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  claim  Claim  @relation(fields: [claimId, tenantId], references: [id, tenantId], onDelete: Cascade)
  source Source @relation(fields: [sourceId, tenantId], references: [id, tenantId])

  @@index([tenantId, sourceId])
  @@index([claimId])
}

// ───────────────────────── Market & buyer ─────────────────────────

model Persona {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  role        String
  market      String
  goals       String[]
  concerns    String[]
  isSynthetic Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  buyerProblems     BuyerProblem[]
  valuePropositions ValueProposition[]
  campaigns         Campaign[]

  @@unique([id, tenantId])
  @@index([tenantId])
}

model BuyerProblem {
  id          String   @id @default(cuid())
  tenantId    String
  personaId   String
  statement   String
  severity    Int      @default(3)
  isSynthetic Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  persona           Persona            @relation(fields: [personaId, tenantId], references: [id, tenantId], onDelete: Cascade)
  valuePropositions ValueProposition[]

  @@unique([id, tenantId])
  @@index([tenantId, personaId])
}

model ValueProposition {
  id             String   @id @default(cuid())
  tenantId       String
  featureId      String
  buyerProblemId String
  personaId      String
  statement      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feature      ProductFeature          @relation(fields: [featureId, tenantId], references: [id, tenantId])
  buyerProblem BuyerProblem            @relation(fields: [buyerProblemId, tenantId], references: [id, tenantId])
  persona      Persona                 @relation(fields: [personaId, tenantId], references: [id, tenantId])
  claims       ValuePropositionClaim[]

  @@unique([id, tenantId])
  @@index([tenantId])
}

/// Composite FKs on (id, tenantId) make cross-tenant links impossible at DB level.
model ValuePropositionClaim {
  tenantId           String
  valuePropositionId String
  claimId            String

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  valueProposition ValueProposition @relation(fields: [valuePropositionId, tenantId], references: [id, tenantId], onDelete: Cascade)
  claim            Claim            @relation(fields: [claimId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@id([valuePropositionId, claimId])
  @@index([tenantId])
}

model Competitor {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  website       String?
  isPlaceholder Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evidence          CompetitorEvidence[]
  winLossInterviews WinLossInterview[]

  @@unique([id, tenantId])
  @@index([tenantId])
}

model CompetitorEvidence {
  id           String     @id @default(cuid())
  tenantId     String
  competitorId String
  sourceId     String
  assertion    String
  excerpt      String
  locator      String?
  state        ClaimState @default(draft)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  competitor Competitor @relation(fields: [competitorId, tenantId], references: [id, tenantId], onDelete: Cascade)
  source     Source     @relation(fields: [sourceId, tenantId], references: [id, tenantId])

  @@unique([id, tenantId])
  @@index([tenantId, competitorId])
}

model RegulatoryTrigger {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  jurisdiction String
  summary      String
  sourceIds    String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  watches RegulatoryWatch[]

  @@unique([id, tenantId])
  @@index([tenantId])
}

// ───────────────────────── Regulatory radar (M16) ─────────────────────────

/// A watched regulatory item (e.g. the application date of an obligation). Its
/// current wording lives in a Source (kind regulatory_text). Recording a change
/// updates that source, marks dependent claims stale and stores the impact.
model RegulatoryWatch {
  id                  String    @id @default(cuid())
  tenantId            String
  name                String
  jurisdiction        String
  topic               String
  sourceId            String
  regulatoryTriggerId String?
  currentDeadline     DateTime? @db.Date
  isSynthetic         Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source  Source             @relation(fields: [sourceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  trigger RegulatoryTrigger? @relation(fields: [regulatoryTriggerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  changes RegulatoryChange[]

  @@unique([id, tenantId])
  @@index([tenantId])
}

/// An open alert until a reviewer resolves it — which is only possible once
/// every claim it made stale has been re-verified or retired.
model RegulatoryChange {
  id                  String               @id @default(cuid())
  tenantId            String
  watchId             String
  kind                RegulatoryChangeKind
  summary             String
  previousDeadline    DateTime?            @db.Date
  newDeadline         DateTime?            @db.Date
  previousContentHash String
  newContentHash      String
  /// Computed at recording time: stale claim ids and affected assets with reasons.
  impact              Json
  recordedById        String
  resolvedAt          DateTime?
  resolvedById        String?
  resolutionNote      String?
  createdAt           DateTime             @default(now())

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  watch      RegulatoryWatch @relation(fields: [watchId, tenantId], references: [id, tenantId], onDelete: Cascade)
  recordedBy User            @relation("ChangeRecordedBy", fields: [recordedById], references: [id])
  resolvedBy User?           @relation("ChangeResolvedBy", fields: [resolvedById], references: [id])

  @@unique([id, tenantId])
  @@index([tenantId, resolvedAt])
}

// ───────────────────────── Win/loss & research (M14) ─────────────────────────

/// One win/loss (or churn) interview. Human input. The account is pseudonymised
/// (no personal names). Notes are stored only with GRANTED consent, as a
/// confidential Source of kind "interview" — so statements in a synthesis can
/// cite verbatim excerpts (gate G4). Withdrawn consent erases the notes and
/// invalidates the source; everything that cited it fails the gates again.
model WinLossInterview {
  id             String        @id @default(cuid())
  tenantId       String
  productId      String
  /// Pseudonymised account label, e.g. "Mid-sized automotive supplier A".
  accountLabel   String
  segment        String
  outcome        DealOutcome
  decidedOn      DateTime?     @db.Date
  /// The competitor the deal was won against or lost to (same tenant).
  competitorId   String?
  /// Reason codes from the fixed taxonomy (src/domain/research/win-loss.ts).
  reasons        String[]
  /// The single most important reason (one of `reasons`).
  primaryReason  String
  interviewedOn  DateTime?     @db.Date
  consentStatus  ConsentStatus @default(requested)
  consentRecordedAt DateTime?
  /// Interview notes live in this source (null without granted consent).
  sourceId       String?
  isSynthetic    Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [productId, tenantId], references: [id, tenantId])
  competitor Competitor? @relation(fields: [competitorId, tenantId], references: [id, tenantId], onDelete: Restrict)
  source     Source?     @relation(fields: [sourceId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, productId])
}

// ───────────────────────── Campaigns (M8–M10) ─────────────────────────

/// Human-entered campaign briefing. The campaign_gtm run turns it into three
/// deliverables (campaign plan, content matrix, sales play) that go through the
/// same gates and human review as every other asset. Nothing is sent or
/// published from here: deliverables leave the system only as approved exports.
model Campaign {
  id                    String       @id @default(cuid())
  tenantId              String
  name                  String
  type                  CampaignType
  objective             String
  productId             String
  personaId             String
  market                String
  /// M12: communication channels (LinkedIn, email, webinar …) — previously "channels".
  communicationChannels String[]
  /// M12: sales channels (direct_sales, partner_reseller, customer_success …; see SalesChannel).
  salesChannels         String[]     @default([])
  startsOn              DateTime?    @db.Date
  endsOn                DateTime?    @db.Date
  budgetEur             Decimal?     @db.Decimal(12, 2)
  isSynthetic           Boolean      @default(false)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId, tenantId], references: [id, tenantId])
  persona      Persona       @relation(fields: [personaId, tenantId], references: [id, tenantId])
  assets       Asset[]
  workflowRuns WorkflowRun[]
  kpis         Kpi[]
  kpiImports   KpiImport[]

  @@unique([id, tenantId])
  @@index([tenantId])
}

// ───────────────────────── KPIs (M11) ─────────────────────────

/// One KPI of a campaign, created from the APPROVED campaign plan. The plan only
/// proposes targets; the numeric target and baseline are set by a human.
/// M12: a planned release or update of a product (station "Release & update"). Human input;
/// the release_communication run turns it into a communication plan for review.
model Release {
  id                    String      @id @default(cuid())
  tenantId              String
  productId             String
  name                  String
  version               String
  type                  ReleaseType
  plannedOn             DateTime?   @db.Date
  summary               String
  changes               String[]
  /// existing_customers, prospects, partners_resellers, internal_sales, internal_support (see ReleaseAudience)
  audiences             String[]
  communicationChannels String[]
  salesChannels         String[]    @default([])
  isSynthetic           Boolean     @default(false)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId, tenantId], references: [id, tenantId])
  assets       Asset[]
  workflowRuns WorkflowRun[]
  launches     Launch[]

  @@unique([id, tenantId])
  @@index([tenantId, plannedOn])
}

/// M15 station "Launch": a staged launch of a product (optionally tied to a release). Human input.
/// Readiness per phase is computed in code from approved deliverables, claims and proof; a phase
/// can only get a human "go" when its required checks pass (LaunchDecision).
model Launch {
  id                    String     @id @default(cuid())
  tenantId              String
  productId             String
  releaseId             String?
  name                  String
  tier                  LaunchTier
  summary               String
  pricingModel          String
  targetSegments        String
  earlyAccessOn         DateTime?  @db.Date
  generalAvailabilityOn DateTime?  @db.Date
  customerLaunchOn      DateTime?  @db.Date
  marketLaunchOn        DateTime?  @db.Date
  /// External customers who agreed to be named or to take reference calls.
  externalReferences    Int        @default(0)
  /// "Customer zero": the company runs the product itself and documented it.
  internalPilot         Boolean    @default(false)
  isSynthetic           Boolean    @default(false)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product      Product          @relation(fields: [productId, tenantId], references: [id, tenantId])
  release      Release?         @relation(fields: [releaseId, tenantId], references: [id, tenantId], onDelete: Restrict)
  assets       Asset[]
  workflowRuns WorkflowRun[]
  decisions    LaunchDecision[]

  @@unique([id, tenantId])
  @@index([tenantId])
}

/// M15: go / no-go per launch phase, by a human reviewer, with the readiness snapshot it was based on.
model LaunchDecision {
  id          String      @id @default(cuid())
  tenantId    String
  launchId    String
  phase       LaunchPhase
  decision    GoDecision
  comment     String?
  /// The computed readiness of the phase at decision time (checks and their status).
  readiness   Json
  decidedById String
  createdAt   DateTime    @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  launch    Launch @relation(fields: [launchId, tenantId], references: [id, tenantId], onDelete: Cascade)
  decidedBy User   @relation(fields: [decidedById], references: [id])

  @@index([tenantId, launchId])
}

model Kpi {
  id              String         @id @default(cuid())
  tenantId        String
  campaignId      String
  name            String
  funnelStage     String
  definition      String
  dataSource      String
  /// Order of the KPI in the approved plan (funnel order as the plan lists it).
  position        Int            @default(0)
  unit            KpiUnit        @default(count)
  direction       KpiDirection   @default(higher_is_better)
  aggregation     KpiAggregation @default(sum)
  target          Decimal?       @db.Decimal(18, 4)
  baseline        Decimal?       @db.Decimal(18, 4)
  /// Provenance only: the approved campaign_plan version the KPI came from.
  sourceVersionId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign     Campaign         @relation(fields: [campaignId, tenantId], references: [id, tenantId], onDelete: Cascade)
  measurements KpiMeasurement[]

  @@unique([id, tenantId])
  @@unique([campaignId, name])
  @@index([tenantId, campaignId])
}

/// One measured value per KPI and period start. A later import of the same
/// period replaces the value (and records which import did it).
model KpiMeasurement {
  id          String   @id @default(cuid())
  tenantId    String
  kpiId       String
  periodStart DateTime @db.Date
  value       Decimal  @db.Decimal(18, 4)
  importId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kpi    Kpi       @relation(fields: [kpiId, tenantId], references: [id, tenantId], onDelete: Cascade)
  import KpiImport @relation(fields: [importId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([kpiId, periodStart])
  @@index([tenantId, kpiId])
  @@index([importId])
}

/// A CSV import (who, when, how many rows; rejected rows with line and reason — no raw file content).
model KpiImport {
  id           String   @id @default(cuid())
  tenantId     String
  campaignId   String
  fileName     String
  rowCount     Int
  acceptedRows Int
  rejectedRows Json
  importedById String?
  createdAt    DateTime @default(now())

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign     Campaign         @relation(fields: [campaignId, tenantId], references: [id, tenantId], onDelete: Cascade)
  measurements KpiMeasurement[]

  @@unique([id, tenantId])
  @@index([tenantId, campaignId])
}

// ───────────────────────── Assets, runs, approvals ─────────────────────────

model Asset {
  id               String     @id @default(cuid())
  tenantId         String
  type             AssetType
  title            String
  state            AssetState @default(draft)
  currentVersionId String?
  /// Set for campaign deliverables (same tenant, composite FK).
  campaignId       String?
  /// M12: set for release communication plans (same tenant, composite FK).
  releaseId        String?
  /// M15: set for launch plans (same tenant, composite FK).
  launchId         String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Restrict (not SetNull): SetNull would also null tenantId of the composite key.
  campaign Campaign?      @relation(fields: [campaignId, tenantId], references: [id, tenantId], onDelete: Restrict)
  release  Release?       @relation(fields: [releaseId, tenantId], references: [id, tenantId], onDelete: Restrict)
  launch   Launch?        @relation(fields: [launchId, tenantId], references: [id, tenantId], onDelete: Restrict)
  versions AssetVersion[]

  @@unique([id, tenantId])
  @@index([tenantId, state])
  @@index([tenantId, campaignId])
  @@index([tenantId, releaseId])
  @@index([tenantId, launchId])
}

/// Immutable. The data-access layer exposes no update path for content fields.
model AssetVersion {
  id               String         @id @default(cuid())
  tenantId         String
  assetId          String
  versionNumber    Int
  schemaVersion    String
  content          Json
  /// Result of the automated quality gates (src/domain/quality-gates).
  gateReport       Json
  gatesPassed      Boolean
  generationMode   GenerationMode
  workflowRunId    String?
  /// For human_edit versions: the version the edit was based on (same tenant).
  basedOnVersionId String?
  createdAt        DateTime       @default(now())

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset       Asset          @relation(fields: [assetId, tenantId], references: [id, tenantId], onDelete: Cascade)
  workflowRun WorkflowRun?   @relation(fields: [workflowRunId], references: [id])
  basedOn     AssetVersion?  @relation("VersionBase", fields: [basedOnVersionId, tenantId], references: [id, tenantId], onDelete: NoAction)
  derived     AssetVersion[] @relation("VersionBase")
  approvals   Approval[]

  @@unique([assetId, versionNumber])
  @@unique([id, tenantId])
  @@index([tenantId])
}

model WorkflowRun {
  id              String         @id @default(cuid())
  tenantId        String
  kind            String
  status          WorkflowStatus @default(created)
  idempotencyKey  String
  generationMode  GenerationMode
  modelId         String?
  promptVersions  Json
  inputRefs       Json
  usage           Json?
  costEstimateUsd Decimal?       @db.Decimal(10, 4)
  error           String?
  attempts        Int            @default(0)
  /// Set for campaign runs (same tenant, composite FK).
  campaignId      String?
  /// M12: set for release_communication runs (same tenant, composite FK).
  releaseId       String?
  /// M15: set for launch_planning runs (same tenant, composite FK).
  launchId        String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign      Campaign?      @relation(fields: [campaignId, tenantId], references: [id, tenantId], onDelete: Restrict)
  release       Release?       @relation(fields: [releaseId, tenantId], references: [id, tenantId], onDelete: Restrict)
  launch        Launch?        @relation(fields: [launchId, tenantId], references: [id, tenantId], onDelete: Restrict)
  assetVersions AssetVersion[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@index([tenantId, campaignId])
  @@index([tenantId, releaseId])
  @@index([tenantId, launchId])
}

model Approval {
  id             String           @id @default(cuid())
  tenantId       String
  assetVersionId String
  reviewerId     String
  decision       ApprovalDecision
  comment        String?
  createdAt      DateTime         @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assetVersion AssetVersion @relation(fields: [assetVersionId, tenantId], references: [id, tenantId])
  reviewer     User         @relation(fields: [reviewerId], references: [id])

  @@index([tenantId, assetVersionId])
}

model AuditEvent {
  id         String   @id @default(cuid())
  tenantId   String
  actorId    String?
  action     String
  entityType String
  entityId   String
  /// Sanitized metadata only — never credentials, prompts or personal data.
  metadata   Json?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
}
