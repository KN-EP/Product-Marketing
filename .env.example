# Copy to .env — never commit real values.

# ── Database ──────────────────────────────────────────────────────────────
# Local Docker Postgres (no TLS needed on 127.0.0.1):
# Schema OWNER role. Used ONLY by the Prisma CLI (prisma migrate ...), never by the app.
MIGRATION_DATABASE_URL="postgresql://pmm_admin:pmm_admin_dev@localhost:5432/pmm_os?schema=public"
# Least-privilege app role (DML only: SELECT/INSERT/UPDATE/DELETE). Used by the app and the seed.
DATABASE_URL="postgresql://pmm_app:pmm_app_dev@localhost:5432/pmm_os?schema=public"

# Hosted Postgres (e.g. Neon): the TLS parameter depends on WHICH CLIENT reads the URL.
#  - URLs read by node-postgres (DATABASE_URL, TEST_DATABASE_URL — app, seed, tests):
#      ...?sslmode=verify-full            (full certificate + hostname verification)
#  - URLs read by the Prisma schema engine (MIGRATION_DATABASE_URL, TEST_MIGRATION_DATABASE_URL):
#      ...?sslmode=require&sslaccept=strict
#    The schema engine does not recognise verify-full (unknown sslmode values are
#    silently accepted) and its default is sslaccept=accept_invalid_certs, so
#    sslaccept=strict is what turns on certificate validation for migrations.
# MIGRATION_DATABASE_URL="postgresql://OWNER:PASSWORD@HOST/DB?sslmode=require&sslaccept=strict"
# DATABASE_URL="postgresql://pmm_app:PASSWORD@HOST/DB?sslmode=verify-full"

# Integration tests (npm run test:integration). Must be a SEPARATE database
# (e.g. a dedicated Neon branch) — the runner refuses to use DATABASE_URL's DB.
# If unset, integration tests report NOT EXECUTED (exit code 2).
TEST_DATABASE_URL=""          # node-postgres → sslmode=verify-full
# Owner role for migrating the test DB; defaults to TEST_DATABASE_URL.
TEST_MIGRATION_DATABASE_URL="" # Prisma schema engine → sslmode=require&sslaccept=strict

# ── LLM provider ──────────────────────────────────────────────────────────
# Live calls happen ONLY when LLM_MODE="live" AND ANTHROPIC_API_KEY AND
# ANTHROPIC_MODEL are all set; otherwise the app runs in deterministic SIMULATED
# mode and shows a banner. The model ID is never defaulted in code.
ANTHROPIC_API_KEY=""
# Exact model ID from https://platform.claude.com/docs/en/about-claude/models
# (e.g. "claude-opus-5-5" as of 2026-10). No date suffixes.
ANTHROPIC_MODEL=""
LLM_MODE="simulated"          # simulated | live
LLM_MAX_COST_USD_PER_RUN="2.00"

# ── Demo auth ─────────────────────────────────────────────────────────────
# DEMO_MODE=true enables credentials login for SEEDED DEMO USERS ONLY.
# The password-less identity switcher is additionally forced off when NODE_ENV=production.
DEMO_MODE="true"
# Password for all seeded demo users (prisma db seed). At least 12 characters.
DEMO_USER_PASSWORD="change-me-demo-password"
# Seals the session cookie. At least 32 characters, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="change-me-to-32+-random-bytes"
